{
  "name": "handyapp",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "npm run build && npx firebase-tools@latest deploy --only hosting",
    "deploy:hosting": "npm run deploy",
    "set-owner-claim": "node scripts/setOwnerClaim.mjs",
    "seed-handyman-tasks": "node scripts/seedHandymanTasks.mjs",
    "invoice-api": "node server/invoiceApi.mjs",
    "preview:admin": "vite --config scripts/admin-preview/vite.config.js",
    "preview:admin:phone": "vite build --config scripts/admin-preview/vite.config.js && node scripts/admin-preview/serve.mjs",
    "preview:pwa": "vite build --config scripts/admin-preview/vite.config.js && HANDY_PREVIEW_PORT=5176 node scripts/admin-preview/serve.mjs"
  },
  "dependencies": {
    "@handy/shared": "file:./shared",
    "firebase": "^11.0.0",
    "firebase-admin": "^13.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "square": "^43.2.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  }
}
