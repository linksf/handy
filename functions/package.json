{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "sync:shared": "node scripts/sync-shared.js",
    "build": "npm run sync:shared && tsc",
    "test:lead-automation": "npm run build && node --test scripts/lead-automation.test.cjs scripts/lead-automation-store.test.cjs scripts/lead-scheduling.test.cjs",
    "build:watch": "tsc --watch",
    "serve": "npm run build && npx firebase-tools@latest emulators:start --only functions",
    "shell": "npm run build && npx firebase-tools@latest functions:shell",
    "start": "npm run shell",
    "deploy": "npm run build && npx firebase-tools@latest deploy --only functions",
    "logs": "npx firebase-tools@latest functions:log",
    "genkit:start": "genkit start -- tsx --watch src/genkit-sample.ts",
    "test:lead-contacts": "npm run build && node --test scripts/lead-contacts.test.cjs",
    "test:lead-notifications": "npm run build && node --test scripts/lead-notifications.test.cjs",
    "test:lead-first": "npm run build && node --test scripts/lead-first.test.cjs"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@genkit-ai/firebase": "^1.30.1",
    "@handy/shared": "file:./shared",
    "express": "^5.2.1",
    "firebase": "^12.15.0",
    "firebase-admin": "^13.6.0",
    "firebase-cli": "^1.2.0",
    "firebase-functions": "^7.2.5",
    "genkit": "^1.30.1",
    "google-auth-library": "^10.9.1",
    "square": "^44.1.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "private": true
}
